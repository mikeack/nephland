#!/bin/sh
# Safety net: never let private data or hidden locations reach the public repo.
cd "$(git rev-parse --show-toplevel)" || exit 1
if git diff --cached --name-only | grep -E '^(dm|dm-preview)/' >/dev/null; then
  echo "Commit blocked: files from dm/ or dm-preview/ are staged. They must stay private."; exit 1
fi
if [ -d dm ]; then
  python3 nephland.py build || exit 1
  git add docs
fi
python3 nephland.py check || { echo "Commit blocked: leak check failed."; exit 1; }
